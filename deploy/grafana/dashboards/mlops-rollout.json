    {
      "type": "timeseries",
      "title": "Traffic share by variant",
      "description": "In A/B mode the challenger band should match the configured split (sample-ratio check).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (variant) (rate(mlops_predictions_total[$__rate_interval]))",
          "legendFormat": "{{variant}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "linear",
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "percent",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
